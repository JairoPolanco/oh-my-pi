{
	"type": "module",
	"name": "@oh-my-pi/pi-kernel",
	"version": "17.2.12",
	"description": "Constitutional kernel: events, artifacts, capabilities, policy, context, verification, and runtime seams for the Oh My Pi harness",
	"homepage": "https://omp.sh",
	"author": "Jairo Polanco",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/JairoPolanco/oh-my-pi.git",
		"directory": "packages/kernel"
	},
	"bugs": {
		"url": "https://github.com/JairoPolanco/oh-my-pi/issues"
	},
	"keywords": [
		"agent",
		"kernel",
		"events",
		"artifacts",
		"capabilities",
		"policy"
	],
	"main": "./src/index.ts",
	"module": "./src/index.ts",
	"types": "./src/index.ts",
	"scripts": {
		"check": "biome check . && bun run check:types",
		"check:types": "tsgo -p tsconfig.json --noEmit",
		"lint": "biome lint .",
		"test": "bun test --parallel",
		"fix": "biome check --write --unsafe .",
		"fmt": "biome format --write ."
	},
	"dependencies": {},
	"devDependencies": {
		"@types/bun": "catalog:"
	},
	"engines": {
		"bun": ">=1.3.14"
	},
	"files": [
		"src",
		"README.md",
		"CHANGELOG.md"
	],
	"exports": {
		".": {
			"types": "./src/index.ts",
			"import": "./src/index.ts"
		},
		"./events": {
			"types": "./src/events/index.ts",
			"import": "./src/events/index.ts"
		},
		"./artifacts": {
			"types": "./src/artifacts/index.ts",
			"import": "./src/artifacts/index.ts"
		},
		"./capabilities": {
			"types": "./src/capabilities/index.ts",
			"import": "./src/capabilities/index.ts"
		},
		"./policy": {
			"types": "./src/policy/index.ts",
			"import": "./src/policy/index.ts"
		},
		"./context": {
			"types": "./src/context/index.ts",
			"import": "./src/context/index.ts"
		},
		"./verification": {
			"types": "./src/verification/index.ts",
			"import": "./src/verification/index.ts"
		},
		"./runtime": {
			"types": "./src/runtime/index.ts",
			"import": "./src/runtime/index.ts"
		},
		"./actors": {
			"types": "./src/actors/index.ts",
			"import": "./src/actors/index.ts"
		},
		"./workflow": {
			"types": "./src/workflow/index.ts",
			"import": "./src/workflow/index.ts"
		},
		"./learning": {
			"types": "./src/learning/index.ts",
			"import": "./src/learning/index.ts"
		},
		"./gateway": {
			"types": "./src/gateway/index.ts",
			"import": "./src/gateway/index.ts"
		},
		"./memory": {
			"types": "./src/memory/index.ts",
			"import": "./src/memory/index.ts"
		},
		"./models": {
			"types": "./src/models/index.ts",
			"import": "./src/models/index.ts"
		},
		"./sessions": {
			"types": "./src/sessions/index.ts",
			"import": "./src/sessions/index.ts"
		},
		"./*": {
			"types": "./src/*.ts",
			"import": "./src/*.ts"
		}
	}
}
